<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Presentacion</RootNamespace>
    <AssemblyName>SistemaVentas</AssemblyName>
    <ApplicationIcon>Resources\Logo.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <ProjectGuid>{F7BF48AD-C64C-43A2-A96C-7778E7A19AC9}</ProjectGuid>
    <!-- Se conserva Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sin documentación XML en todos los métodos de los formularios -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Excel -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Gráficos de las ventanas de estadísticas: port para .NET del control Chart de .NET Framework -->
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />
    <!-- Mapa de sucursales -->
    <PackageReference Include="GMap.NET.WinForms" Version="2.1.7" />
    <!-- Dependencia de GMap.NET.Core (caché de mapas en SQL Server, no se usa): se fija una versión sin vulnerabilidades (trae la 4.8.3) -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <!-- PDF de detalle de compras y ventas. Solo existe para .NET Framework; funciona en modo compatibilidad -->
    <PackageReference Include="iTextSharp" Version="5.5.13.4" NoWarn="NU1701" />
    <PackageReference Include="itextsharp.xmlworker" Version="5.5.13.4" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Datos\Datos.csproj" />
    <ProjectReference Include="..\Entidad\Entidad.csproj" />
    <ProjectReference Include="..\Negocios\Negocios.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <!-- Logo que se inserta en los PDF de estadísticas (se lee desde la carpeta del ejecutable) -->
    <None Update="Resources\Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

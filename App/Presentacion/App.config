<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Cadena de conexión de la aplicación. La variable de entorno SISTEMA_VENTAS_DB, si existe, tiene prioridad.
	     TrustServerCertificate: Microsoft.Data.SqlClient cifra la conexión por defecto y SQL Server Express usa un
	     certificado autofirmado; sin esto la conexión falla con "certificate chain was issued by an authority that is not trusted". -->
	<connectionStrings>
		<add name="ConexionBD" connectionString="server=(localdb)\MSSQLLocalDB;database= Sistema_Ventas;integrated security=true;TrustServerCertificate=true;" providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
</configuration>
